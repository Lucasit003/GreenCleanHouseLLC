# Copy to `.env` and fill in real values. NEVER commit `.env`.
# This file documents variable NAMES only — it contains no real secrets.

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5432/tradingsys

# --- Market data vendor (adapter-selected) ---
MARKET_DATA_PROVIDER=databento
MARKET_DATA_API_KEY=__set_in_secrets_manager__

# --- News vendor ---
NEWS_PROVIDER=trading_economics
NEWS_API_KEY=__set_in_secrets_manager__

# --- Broker / execution (Topstep) ---
EXECUTION_MODE=paper            # paper | live  (paper is the default)
BROKER=topstep
BROKER_API_KEY=__set_in_secrets_manager__
BROKER_ACCOUNT_ID=__set__

# --- Webull OpenAPI (practice: PAPER account only) ---
# Get these from developer.webull.com after your API application is approved.
# Keep them here in your LOCAL .env only — never commit this file.
WEBULL_APP_KEY=__paste_your_app_key__
WEBULL_APP_SECRET=__paste_your_app_secret__
WEBULL_REGION=us
WEBULL_PAPER=true               # true = paper/simulation account (keep this)
WEBULL_FUTURES_ACCOUNT_ID=DEN38CJ3   # your futures paper account id

# --- Runtime ---
ENV=dev                         # dev | staging | prod
